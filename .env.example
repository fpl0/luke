# Required: Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Required: one of these for Claude authentication
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=

# Optional
# ASSISTANT_NAME=Luke
# MAX_CONCURRENT=5

# Letta backends (optional — both default to the sqlite/sdk paths).
# The ids are deployment-specific, printed by the provisioning scripts:
# scripts/letta_load_bge_titled.py (archive), scripts/letta_luke_on_claude.py (agent).
# MEMORY_BACKEND=sqlite            # or: letta (recall candidates from a Letta server)
# AGENT_BACKEND=sdk                # or: letta (world model from Letta core blocks)
# LETTA_BASE_URL=http://localhost:8283
# LETTA_ARCHIVE_ID=
# LETTA_AGENT_ID=
# LETTA_WRITE_THROUGH=true
