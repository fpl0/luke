# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.venv
.ruff_cache/
.mypy_cache
.coverage
.pytest_cache

# Environment
.env

# Claude Code (user-specific)
.claude/settings.local.json

# OS
.DS_Store

# Embed server — runtime logs the daemon writes at repo root
bgeembed.log
bgeembed.err

# Data belongs in $LUKE_DIR, never the repo
luke.db
workspace/
logs/

# Canary verdicts live next to their script (deliberately not in behavior_state, so a
# daemon that cannot write its own state cannot silence them) but are runtime, not source
scripts/*.state.json
